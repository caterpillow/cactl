% The name for this page's header list. \detokenize: literal text, so the
% name survives the trip through \write18 and header.tmp unexpanded.
\newcommand{\kactlref}[1]{\marks\hdrmark{\detokenize{#1}}}

% Like \needspace, except with flush bottoms.
\newcommand{\myneedspace}[1]{%
  \begingroup
    \setlength{\dimen@}{#1}%
    \vskip\dimen@
    \penalty 9999%
    \vskip -\dimen@
    \vskip\z@skip
  \endgroup
}

% Every line ends in % (or a control word): chapter prose may precede us
% without a blank line, and stray end-of-line spaces would land in that
% paragraph (or in the name line) as glue.
\newcommand{\kactlimport}[2][]{% #1: extra preprocessor flags, #2: file name
	\par
	\if@nobreak\nobreak\else % directly after a heading: stay attached to it
		\myneedspace{3\baselineskip}%
		\penalty-100
	\fi
	\immediate\write18{rm -f \@builddir/kactl.tmp \@builddir/kactl-code.tmp}% never typeset a stale one
	\immediate\write18{python3 content/tex/preprocessor.py -i "\@kactldir/#2" -o \@builddir/kactl.tmp \kactl@engineopt\space#1}%
	\input{\@builddir/kactl.tmp}%
}

