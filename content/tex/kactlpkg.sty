% Include a list of source files at the top of every page. TeX ships pages
% asynchronously (noticeably so under multicol), so the names are recorded as
% eTeX marks: \kactlref places \marks\hdrmark{name} right after each template
% name line. multicol keeps only class-0 marks per column, and \botmarks can
% already point into material that was pushed to the NEXT page, so we hook
% multicol's \set@keptmarks (run right after every column \vsplit) and remember
% the last \hdrmark any column of the current page contained; \@outputpage
% resets it once the header has been typeset. Since LaTeX is terrible at
% string manipulation, the Python side prints every not-yet-printed name up to
% that one, keeping its state in header.tmp (repo root = cwd of pdflatex).
\newmarks\hdrmark
\let\kactl@hdrlast\@empty
\g@addto@macro\set@keptmarks{%
	\expandafter\def\expandafter\kactl@tmp\expandafter{\splitbotmarks\hdrmark}%
	\ifx\kactl@tmp\@empty\else\global\let\kactl@hdrlast\kactl@tmp\fi}
\g@addto@macro\@outputpage{\global\let\kactl@hdrlast\@empty}
\pagestyle{fancy}
\renewcommand{\headrulewidth}{0pt}
\newcommand{\@leftheadertext}{%
	\ifthenelse{\equal{\@unishort}{ }\OR\equal{\@unishort}{}\OR\equal{\@teamname}{}}%
		{\@unishort\@teamname}{\@unishort\ \textbar\ \@teamname}%
}
% Width of the centre header's file list when it wraps to two lines. It is a
% length, not arithmetic in the generated header file: that file is \input
% from the output routine, and a \dimexpr there printed "10cm" into the
% header of any page whose break fell inside a minted listing.
\newlength{\kactlheadlist}
\newcommand{\kactl@synchead}{%
	\fancyheadoffset{0pt}\fancyfootoffset{0pt}% re-sync \headwidth
	\setlength{\kactlheadlist}{\headwidth}\addtolength{\kactlheadlist}{-10cm}%
}
\lhead{\@leftheadertext}
\chead{\immediate\write18{rm -f \@builddir/header2.tmp}\immediate\write18{python3 content/tex/preprocessor.py --print-header "\kactl@hdrlast" -o \@builddir/header2.tmp}\input{\@builddir/header2.tmp}}
\rhead{\thepage}
%\lhead{}\chead{\thepage}\rhead{}
\lfoot{}\cfoot{}\rfoot{}
\kactl@synchead

% \kactlmargins{left}{right}{top}{bottom}: page margins for the A4 landscape
% output (defaults 0.5cm 0.5cm 1.1cm 0.4cm). The page header (a 25pt box plus
% a 2pt gap, text bottom-aligned, a long file list wraps upward onto two
% \footnotesize lines) hangs from the top margin: with top = 1.1cm the header
% text stays >= 4mm from the paper edge, which is about what printers need;
% top < 27pt puts the header box itself above the paper.
\newcommand{\kactlmargins}[4]{
	\geometry{left=#1,right=#2,top=#3,bottom=#4}
	\kactl@synchead
}
% \kactlbinding{len}: extra room on the binding edge for double-sided
% printing (inner edge of every page, alternating). For single-sided stapling
% just give \kactlmargins a bigger left margin.
\newif\ifkactl@binding
\newcommand{\kactlbinding}[1]{
	\geometry{twoside,bindingoffset=#1}
	\fancyheadoffset{0pt}\fancyfootoffset{0pt}
	\kactl@bindingtrue
}
% The cover is logical page 0, so LaTeX's odd/even parity is the reverse of
% the physical sheet sides: printed page 1 (odd) is the back of the cover, a
% verso page whose binding edge is on the RIGHT. Swap the two side margins
% geometry computed -- at \begin{document}, i.e. after every \geometry call.
\AtBeginDocument{\ifkactl@binding
	\@tempdima\oddsidemargin \oddsidemargin\evensidemargin \evensidemargin\@tempdima
\fi}

\renewcommand\chapter{
