% One template, as emitted by the preprocessor:
%   \kactlname{Foo.h} \kactlref{Foo.h} \kactlheader{block}{includes}{hash}
%   \begin{lstlisting}...\end{lstlisting}
% The block is "\textbf{Description:} ... \\ \textbf{Time:} ...", already
% escaped. The tiny caption shares the block's last line when it fits and
% takes its own right-aligned line when it does not.
\newcommand{\kactlname}[1]{{\large #1}\par\nobreak}% \par outside the group: \large must not set the line's leading
\newcommand{\kactlheader}[3]{%
	% \@parboxrestore: the block is justified and \\ breaks a line inside it,
	% i.e. the document's \raggedright does not apply here (listings used to
	% do exactly this when the block rode on its caption mechanism).
	{\par\@parboxrestore\footnotesize\interlinepenalty\@M\noindent
	\if\relax\detokenize{#1}\relax\else % raw listings have no block at all
		#1\unskip\nobreak\hfil\penalty50\hskip1em\hbox{}\nobreak
	\fi
	\hfil{\tiny\texttt{#2}\enspace#3}%
	\parfillskip=0pt \finalhyphendemerits=0 \par}\nobreak
}

