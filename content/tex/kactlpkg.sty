% Columns are ragged, so vertical stretch buys nothing -- but the page builder
% still used it to compute a finite badness, and then LaTeX's \penalty-300
% before headings (or listings' -50, our -100) could beat "fill the column"
% (p3: Absorption pushed to a new page above a big gap). With no stretch every
% feasible break costs the same and TeX takes the last one that fits, i.e.
% columns are filled maximally. Club/widow penalties keep paragraph splits
% clean (never a single line alone), headings keep their next two lines.
\@secpenalty\z@
\setlength{\parskip}{.5\baselineskip}
\clubpenalty\@M \widowpenalty\@M \@clubpenalty\@M
\def\kactl@nostretch{% "1\skip" coerces a glue to its natural width
	\abovedisplayskip=1\abovedisplayskip \belowdisplayskip=1\belowdisplayskip
	\abovedisplayshortskip=1\abovedisplayshortskip
	\belowdisplayshortskip=1\belowdisplayshortskip}
\g@addto@macro\normalsize{\kactl@nostretch}
\g@addto@macro\small{\kactl@nostretch}
\g@addto@macro\footnotesize{\kactl@nostretch}
% Lists too: parskip.sty gives \parsep the stretch \parskip had at load time,
% and size9.clo's \small/\footnotesize \@listi carry their own "plus".
\def\kactl@listnostretch{\topsep=1\topsep \partopsep=1\partopsep
	\parsep=1\parsep \itemsep=1\itemsep}
\g@addto@macro\@listI{\kactl@listnostretch}\let\@listi\@listI
\g@addto@macro\@listii{\kactl@listnostretch}
\g@addto@macro\@listiii{\kactl@listnostretch}
\g@addto@macro\kactl@nostretch{% the size commands \def\@listi afresh
	\expandafter\def\expandafter\@listi\expandafter{\@listi\kactl@listnostretch}}
\normalsize
\smallskipamount=1\smallskipamount \medskipamount=1\medskipamount
\bigskipamount=1\bigskipamount

