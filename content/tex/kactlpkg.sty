% The tiny hash caption shares the last header line when it fits and
% wraps to its own right-aligned line when it doesn't (no more overlap).
\long\def\@makecaption#1#2{
	\vspace{-3pt}
	{\par\noindent\footnotesize\interlinepenalty\@M
	\def\@chsep{}
	\ifthenelse{\boolean{hasdescription}}{\@chsep\textbf{Description:} \@defdescription\def\@chsep{\\}}{}
	\ifthenelse{\boolean{hasusage}}{\@chsep\textbf{Usage:} \@defusage\def\@chsep{\\}}{}
	\ifthenelse{\boolean{hasmemory}}{\@chsep\textbf{Memory:} \@defmemory\def\@chsep{\\}}{}
	\ifthenelse{\boolean{hastime}}{\@chsep\textbf{Time:} \@deftime\def\@chsep{\\}}{}
	\unskip\nobreak\hfil\penalty50\hskip1em\hbox{}\nobreak\hfil
	{\tiny\texttt{\@leftcaption}\enspace\@rightcaption}%
	\parfillskip=0pt \finalhyphendemerits=0 \par}
}

