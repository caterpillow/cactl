% listings inserts a breakpoint (\penalty-50) between the template name and
% its caption; remove it so a name is never orphaned at a column bottom.
\patchcmd{\lst@Init}{\par\penalty-50\relax}{\par\nobreak}{\typeout{kactlpkg: patched lst@Init}}{\PackageError{kactlpkg}{lst@Init patch failed}{}}
\patchcmd{\lst@MakeCaption}{\allowbreak}{\nobreak}{\typeout{kactlpkg: patched lst@MakeCaption}}{\PackageError{kactlpkg}{lst@MakeCaption patch failed}{}}
% Keep a template's caption with its first three code lines: no break at the
% frame glue after the colour whatsit, none after the top rule, none after
% code lines 1 and 2. If that does not fit, the whole template moves.
\patchcmd{\lst@frameInit}{\vskip\@tempdima\vskip\lineskip}{\nobreak\vskip\@tempdima\vskip\lineskip}{}{\PackageError{kactlpkg}{lst@frameInit patch failed}{}}
\lst@AddToHook{Init}{\ifvmode\nobreak\fi}
\lst@AddToHook{EveryLine}{\lst@ifdisplaystyle\ifnum\lst@lineno<3 \vadjust{\nobreak}\fi\fi}
