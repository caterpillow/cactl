}
\lhead{\@leftheadertext}
\chead{\immediate\write18{rm -f \@builddir/header2.tmp}\immediate\write18{python3 content/tex/preprocessor.py --print-header "\kactl@hdrlast" -o \@builddir/header2.tmp}\input{\@builddir/header2.tmp}}
