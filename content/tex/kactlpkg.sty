% Include a list of source files at the top of every page. TeX ships pages
% asynchronously (noticeably so under multicol), so the names are recorded as
% eTeX marks: \kactlref places \marks\hdrmark{name} right after each template
% name line. multicol keeps only class-0 marks per column, and \botmarks can
% already point into material that was pushed to the NEXT page, so we hook
% multicol's \set@keptmarks (run right after every column \vsplit) and remember
% the last \hdrmark any column of the current page contained; \@outputpage
% resets it once the header has been typeset. Since LaTeX is terrible at
% string manipulation, the Python side prints every not-yet-printed name up to
% that one, keeping its state in header.tmp (repo root = cwd of pdflatex).
\newmarks\hdrmark
\let\kactl@hdrlast\@empty
\g@addto@macro\set@keptmarks{%
	\expandafter\def\expandafter\kactl@tmp\expandafter{\splitbotmarks\hdrmark}%
	\ifx\kactl@tmp\@empty\else\global\let\kactl@hdrlast\kactl@tmp\fi}
\g@addto@macro\@outputpage{\global\let\kactl@hdrlast\@empty}
\pagestyle{fancy}
