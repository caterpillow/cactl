% Which renderer typesets the C++ listings.  \kactlhighlight{minted} -- the
% one line in content/kactl.tex -- loads content/tex/kactlhl.sty (Pygments
% syntax highlighting, colour palette at the top of that file) and tells the
% preprocessor to hand the code over to it.  \kactlhighlight{listings} is the
% fallback: the plain listings rendering, needing no Python packages, for a
% machine without Pygments.  Everything that is not C++ -- .vimrc, hash.sh,
% troubleshoot.txt -- stays on listings either way.
\def\kactl@engineopt{}
\newcommand{\kactlhighlight}[1]{%
	\ifthenelse{\equal{#1}{minted}}%
		{\def\kactl@engineopt{-e minted}\RequirePackage{kactlhl}}%
		{\ifthenelse{\equal{#1}{listings}}{}%
			{\kactlerror{\string\kactlhighlight: unknown renderer '#1' (minted or listings)}}}%
}
