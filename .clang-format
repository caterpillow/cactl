# Spacing-only style for the notebook: ColumnLimit 0 keeps every existing
# line break; this normalizes indentation (4 spaces), spaces around
# operators/after commas, and `FOR (i, a, b)`-style control macros.
BasedOnStyle: LLVM
IndentWidth: 4
TabWidth: 4
UseTab: Never
ContinuationIndentWidth: 4
AccessModifierOffset: -4
ColumnLimit: 0
ForEachMacros: [FOR, F0R, ROF]
SpaceBeforeParens: ControlStatements
SpaceAfterCStyleCast: true
SpacesBeforeTrailingComments: 1
AlignTrailingComments: false
AlignAfterOpenBracket: DontAlign
AlignOperands: DontAlign
AlignConsecutiveAssignments: None
AlignEscapedNewlines: DontAlign
AllowShortFunctionsOnASingleLine: All
AllowShortIfStatementsOnASingleLine: AllIfsAndElse
AllowShortLoopsOnASingleLine: true
AllowShortBlocksOnASingleLine: Always
AllowShortCaseLabelsOnASingleLine: true
AllowShortLambdasOnASingleLine: All
BreakBeforeBraces: Attach
KeepEmptyLinesAtTheStartOfBlocks: false
MaxEmptyLinesToKeep: 1
Cpp11BracedListStyle: true
SpaceBeforeCpp11BracedList: false
DerivePointerAlignment: true
SortIncludes: false
IndentCaseLabels: true
NamespaceIndentation: None
ReflowComments: false
FixNamespaceComments: false
SpaceAfterTemplateKeyword: false
SpaceInEmptyBlock: false
